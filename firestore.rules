rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return isSignedIn() &&
        request.auth.token.role == 'administrator';
    }

    function isSeller() {
      return isSignedIn() &&
        request.auth.token.role == 'seller' &&
        request.auth.token.branchId is string &&
        request.auth.token.branchId.matches(
          '^branch-[a-z0-9]+(-[a-z0-9]+)*$'
        );
    }

    function isSellerFor(branchId) {
      return isSeller() && request.auth.token.branchId == branchId;
    }

    function hasValidQuantitySpec() {
      return resource.data.quantitySpec is map &&
        resource.data.quantitySpec.keys().hasOnly(['unit', 'precision']) &&
        resource.data.quantitySpec.keys().hasAll(['unit', 'precision']) &&
        resource.data.quantitySpec.unit is string &&
        resource.data.quantitySpec.unit.matches(
          '^[a-z][a-z0-9_-]{0,31}$'
        ) &&
        resource.data.quantitySpec.precision is int &&
        resource.data.quantitySpec.precision >= 0 &&
        resource.data.quantitySpec.precision <= 6;
    }

    function hasValidPricing() {
      return resource.data.pricing is map &&
        resource.data.pricing.keys().hasOnly([
          'listedPriceCentavos',
          'currency',
          'priceMode',
          'ivaTreatment',
          'ivaRateBasisPoints'
        ]) &&
        resource.data.pricing.keys().hasAll([
          'listedPriceCentavos',
          'currency',
          'priceMode',
          'ivaTreatment',
          'ivaRateBasisPoints'
        ]) &&
        resource.data.pricing.listedPriceCentavos is int &&
        resource.data.pricing.listedPriceCentavos >= 0 &&
        resource.data.pricing.listedPriceCentavos <= 9007199254740991 &&
        resource.data.pricing.currency == 'MXN' &&
        (resource.data.pricing.priceMode == 'iva-included' ||
          resource.data.pricing.priceMode == 'iva-additional-on-invoice') &&
        (resource.data.pricing.ivaTreatment == 'taxable' ||
          resource.data.pricing.ivaTreatment == 'zero-rated' ||
          resource.data.pricing.ivaTreatment == 'exempt') &&
        ((resource.data.pricing.ivaTreatment == 'taxable' &&
            resource.data.pricing.ivaRateBasisPoints is int &&
            resource.data.pricing.ivaRateBasisPoints >= 1 &&
            resource.data.pricing.ivaRateBasisPoints <= 10000) ||
          (resource.data.pricing.ivaTreatment == 'zero-rated' &&
            resource.data.pricing.ivaRateBasisPoints == 0) ||
          (resource.data.pricing.ivaTreatment == 'exempt' &&
            resource.data.pricing.ivaRateBasisPoints == null));
    }

    function isPublicProduct(productId) {
      return resource.data.keys().hasOnly([
          'internalCode',
          'name',
          'quantitySpec',
          'createdAt',
          'pricing',
          'pricingUpdatedAt',
          'lastPricingAuditId'
        ]) &&
        resource.data.keys().hasAll(['internalCode', 'name', 'quantitySpec']) &&
        resource.data.internalCode is string &&
        resource.data.internalCode == productId &&
        resource.data.internalCode.matches('^[A-Z][A-Z0-9-]{7,63}$') &&
        resource.data.name is string &&
        resource.data.name.size() >= 1 &&
        resource.data.name.size() <= 120 &&
        hasValidQuantitySpec() &&
        (!('createdAt' in resource.data) ||
          resource.data.createdAt == null ||
          resource.data.createdAt is timestamp) &&
        (!('pricing' in resource.data) || hasValidPricing()) &&
        (!('pricingUpdatedAt' in resource.data) ||
          resource.data.pricingUpdatedAt == null ||
          resource.data.pricingUpdatedAt is timestamp) &&
        (!('lastPricingAuditId' in resource.data) ||
          resource.data.lastPricingAuditId == null ||
          (resource.data.lastPricingAuditId is string &&
            resource.data.lastPricingAuditId.matches(
              '^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$'
            )));
    }

    // Administrators may inspect legacy records. Sellers may get only strict
    // public documents represented in their assigned branch stock, including
    // zero-stock holdings, and cannot list the catalog because rules are not
    // filters. Trusted server code owns all writes.
    match /products/{productId} {
      allow get: if isAdministrator() ||
        (isSeller() &&
          isPublicProduct(productId) &&
          exists(
            /databases/$(database)/documents/branches/$(request.auth.token.branchId)/stock/$(productId)
          ));
      allow list: if isAdministrator();
      allow write: if false;
    }

    // Branch metadata supports the administrator's global catalog only.
    // Sellers do not need parent-document reads for assigned-branch stock.
    match /branches/{branchId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Stock is branch-scoped. Administrators can inspect every branch and a
    // seller can inspect only the branch carried by their trusted auth claim.
    match /branches/{branchId}/stock/{productId} {
      allow read: if isAdministrator() || isSellerFor(branchId);
      allow write: if false;
    }

    // Collection-group queries use a recursive wildcard rule. Keep this
    // administrator-only so it cannot bypass the seller's branch boundary.
    match /{documentPath=**}/stock/{productId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Acquisition-cost references are isolated from seller-readable product
    // documents and are visible only to administrators.
    match /costs/{productId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Historical intake entries retain acquisition cost snapshots and are
    // therefore restricted to administrators. Trusted server code owns writes.
    match /stockIntakeEntries/{entryId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Idempotency receipts include a normalized acquisition-cost request.
    match /stockIntakeReceipts/{receiptId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Catalog idempotency receipts bind one request to one generated internal
    // code. Only administrators may inspect them; trusted server code owns writes.
    match /productCreationReceipts/{receiptId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Price history keeps immutable old/new policy snapshots and actor identity.
    // Only administrators may inspect it; no client SDK may mutate it.
    match /productPriceAudits/{auditId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Pricing receipts enforce server-side retry idempotency and remain private.
    match /productPriceUpdateReceipts/{receiptId} {
      allow read: if isAdministrator();
      allow write: if false;
    }

    // Movement history deliberately excludes acquisition costs. It is
    // server-owned and immutable to all client SDKs.
    match /inventoryMovements/{movementId} {
      allow read: if isAdministrator() || isSellerFor(resource.data.branchId);
      allow write: if false;
    }

    // Sale returns, their audits, idempotency receipts and the per-sale returned
    // ledger are server-owned. Clients reach corrections only through callables.
    match /saleReturns/{returnId} {
      allow read, write: if false;
    }

    match /saleReturnAudits/{returnId} {
      allow read, write: if false;
    }

    match /saleReturnSubmissionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /saleReturnLedgers/{saleId} {
      allow read, write: if false;
    }

    // Factory-defect replacements, their audits and idempotency receipts are
    // server-owned. Clients reach corrections only through callables.
    match /saleReplacements/{replacementId} {
      allow read, write: if false;
    }

    match /saleReplacementAudits/{replacementId} {
      allow read, write: if false;
    }

    match /saleReplacementSubmissionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Exchanges, their audits and idempotency receipts are server-owned.
    // Clients reach corrections only through callables.
    match /saleExchanges/{exchangeId} {
      allow read, write: if false;
    }

    match /saleExchangeAudits/{exchangeId} {
      allow read, write: if false;
    }

    match /saleExchangeSubmissionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Seller profiles hold only displayName and branchId. Administrators may
    // fetch one by UID; nobody may list them, and only the trusted
    // setSellerProfile callable writes them.
    match /sellerProfiles/{uid} {
      allow get: if isAdministrator();
      allow list: if false;
      allow write: if false;
    }

    // Destination transfer notice read markers (DN-01) are per-seller,
    // per-branch, per-transfer leaves. The trusted markTransferNoticeRead
    // callable owns every write; a seller may only read/list markers inside
    // their own user subtree for their assigned branch, never another
    // seller's markers or another branch's subtree.
    match /transferNoticeReads/{uid}/branches/{branchId}/transfers/{transferId} {
      allow get, list: if isSellerFor(branchId) && request.auth.uid == uid;
      allow write: if false;
    }

    // The full transfer pair record is the private administrator audit. It is
    // written only by the transferInventory callable and stays closed to every
    // client SDK, including administrators, so destination and source
    // branches are invisible outside trusted server code.
    match /transfers/{transferId} {
      allow read, write: if false;
    }

    // New paths remain closed until their access contract has tests.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
